.venv/
__pycache__/
*.pyc
.env
.aider*
*.egg-info/

# Dado versionado só via .gitkeep
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
models/*
!models/.gitkeep

# Claude Code — estado de sessão/local, não é do projeto
.claude/worktrees/
.claude/settings.local.json

# settings.json de projeto (hooks compartilhados pela equipe) —
# exceção a qualquer regra de *.json acima
!.claude/settings.json
